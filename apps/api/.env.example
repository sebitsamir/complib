PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Artifact store (defaults to <monorepo>/storage)
# COMPLIB_STORAGE_ROOT=

# Local dev toggles (never enable in production)
COMPLIB_UNLOCK_PRO_SOURCE=true
COMPLIB_ALLOW_DEV_ADMIN=true

# PostgreSQL — catalog index, users, billing
#
# Runtime uses DIRECT_DATABASE_URL if set, else DATABASE_URL.
# Both must be a real TCP URL: postgres://… or postgresql://…
#
# Neon: copy both URLs from the Neon dashboard.
#   - DATABASE_URL → pooled connection (app runtime)
#   - DIRECT_DATABASE_URL → direct connection (migrations)
# Append ?sslmode=require if your host does not include it.
# If migrate fails with P1001 on first try, wait a few seconds and retry
# (Neon free tier wakes from sleep on the first connection).
DATABASE_URL=postgresql://user:password@localhost:5432/complib
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/complib

# Clerk auth
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Admin API key for protected writes (optional; also set x-complib-admin-key header)
COMPLIB_ADMIN_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
