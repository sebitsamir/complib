# Copy to `.env.local` and adjust.

# Express API
COMPLIB_BACKEND_URL=http://127.0.0.1:5000

# Offline / local UI development without Clerk network calls:
# NEXT_PUBLIC_DISABLE_CLERK_DEV=true

# Optional: unlock Pro source in the Next app without Clerk metadata:
# COMPLIB_UNLOCK_PRO_SOURCE=true

# Optional: override artifact store (defaults to <monorepo>/storage)
# COMPLIB_STORAGE_ROOT=

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
